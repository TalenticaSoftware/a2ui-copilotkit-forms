{
  "name": "prompt-to-form",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Say what you want to do; the agent reads the API's schema and draws the form.",
  "scripts": {
    "dev:all": "concurrently -k -n web,runtime,api -c cyan,magenta,green \"pnpm dev:web\" \"pnpm dev:runtime\" \"pnpm dev:api\"",
    "dev:web": "pnpm --filter @prompt-to-form/web dev",
    "dev:runtime": "pnpm --filter @prompt-to-form/runtime dev",
    "dev:api": "pnpm --filter @prompt-to-form/api dev",
    "build": "pnpm --filter @prompt-to-form/web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint apps boundaries.test.ts",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@ag-ui/a2ui-middleware": "0.0.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "concurrently": "10.0.5",
    "oxlint": "1.80.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
