{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "port": 5174,
      "autoPort": true
    },
    {
      "name": "runtime",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev:server"],
      "port": 4100
    },
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev:api"],
      "port": 4200
    },
    {
      "name": "portal-lite",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "reference/portal-lite", "dev"],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "portal-lite-api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "reference/portal-lite", "dev:server"],
      "port": 4000
    }
  ]
}
