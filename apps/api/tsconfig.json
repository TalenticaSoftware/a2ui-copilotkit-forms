{
  "compilerOptions": {
    "tsBuildInfoFile": "../../node_modules/.tmp/api.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /*
      Its own project, with no path back to src/ or server/.
      That is the point: in production this is a different repository. A
      compiler that would happily resolve `@/a2ui/catalog` from here is a
      compiler that would let the boundary rot without complaint.
    */
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
