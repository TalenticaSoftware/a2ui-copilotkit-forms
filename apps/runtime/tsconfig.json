{
  "compilerOptions": {
    "tsBuildInfoFile": "../../node_modules/.tmp/runtime.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /*
      Bundler resolution, not nodenext.
      The server imports the SAME files the browser does — the catalog is
      generated from the field vocabulary, and having one copy of that is the
      point. Those files are written for a bundler, so extensionless imports are
      correct there; nodenext would demand ".js" suffixes on TypeScript sources
      that no bundler wants. tsx resolves them the bundler way at runtime, so
      this matches what actually runs.
    */
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
