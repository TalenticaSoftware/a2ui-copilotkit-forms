# The model, as "provider/model". The prefix decides which key is required.
# Anything else makes the runtime refuse to start, naming the offending value.
MODEL=google/gemini-3.6-flash

# For google/… — GEMINI_API_KEY or GOOGLE_API_KEY.
# For openai/… — OPENAI_API_KEY.  For anthropic/… — ANTHROPIC_API_KEY.
GEMINI_API_KEY=

# Optional. Shown with their defaults.
# PORT=4100                                              runtime
# API_PORT=4200                                          backend
# API_URL=http://localhost:4200                          runtime → backend
# VITE_RUNTIME_URL=http://localhost:4100/api/copilotkit   browser → runtime
# VITE_API_URL=http://localhost:4200                     browser → backend
# COPILOTKIT_TELEMETRY_DISABLED=true                     defaulted off by the runtime
