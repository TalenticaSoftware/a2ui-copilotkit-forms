# --- Model provider ---
# "provider/model". The provider prefix decides which key is required, so
# switching provider is an edit here and not a code change.
#   openai/…     needs OPENAI_API_KEY
#   anthropic/…  needs ANTHROPIC_API_KEY
#   google/…     needs GOOGLE_API_KEY
#
# Anything else makes the server REFUSE TO START, naming the offending value.
MODEL=openai/gpt-4.1

OPENAI_API_KEY=

# --- Server ---
# PORT=4100

# --- Client ---
# Where the browser reaches the runtime.
# Defaults to http://localhost:4100/api/copilotkit
# VITE_RUNTIME_URL=

# --- Telemetry ---
# CopilotKit's anonymous telemetry is defaulted OFF by server/env.ts.
# Set this to false to opt back in.
# COPILOTKIT_TELEMETRY_DISABLED=true

# --- A2UI catalog ---
# "basic" (default) uses A2UI's own components. "custom" uses ours.
# Both halves must agree.
# A2UI_CATALOG=basic
# VITE_A2UI_CATALOG=basic
